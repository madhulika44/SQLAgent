# =====================================================================
# SQL Agent - configuration template
# Copy this file to `.env` (same folder) and fill in the blank values.
# `.env` is git-ignored; this example file is committed, so NEVER put
# real passwords or API keys here.
# =====================================================================

# ---------------------------------------------------------------------
# SQL Server connection (shared)
# ---------------------------------------------------------------------
# Server name as you type it in SSMS "Connect":
#   default instance      -> localhost
#   named instance (Express) -> localhost\SQLEXPRESS
DB_SERVER=localhost
DB_NAME=FoodDeliveryDB
DB_DRIVER=ODBC Driver 18 for SQL Server
# Driver 18 encrypts by default; a local server uses a self-signed
# certificate, so we tell the driver to trust it. Use "no" in production.
DB_TRUST_SERVER_CERTIFICATE=yes

# ---------------------------------------------------------------------
# Read-only login - used by the SQL Agent (Phases 3-5)
# Must match database/04_create_readonly_user.sql
# ---------------------------------------------------------------------
DB_READONLY_USER=sql_agent_reader
DB_READONLY_PASSWORD=

# ---------------------------------------------------------------------
# Admin connection - used ONLY by data_generator/seed_data.py (Phase 2)
# yes = use your Windows login (Trusted_Connection), user/password ignored
# no  = use the SQL login below (needs write + delete rights)
# ---------------------------------------------------------------------
DB_ADMIN_TRUSTED_CONNECTION=yes
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# ---------------------------------------------------------------------
# LLM providers (free tier)
# ---------------------------------------------------------------------
# Which provider to try first: groq or gemini
LLM_PROVIDER=groq
# If the primary provider errors or hits a rate limit (429), try the other one.
LLM_FALLBACK_ENABLED=true

# Groq - get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Production models: https://console.groq.com/docs/models
# Alternative: llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini - get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Models / free tier: https://ai.google.dev/gemini-api/docs/pricing
# Alternatives: gemini-3.5-flash-lite (fastest), gemini-3.8-flash (newest, often overloaded on free tier)
GEMINI_MODEL=gemini-3.6-flash

# 0 = most deterministic output, which is what we want for SQL.
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------
# Agent behaviour
# ---------------------------------------------------------------------
# How many times the LLM may try to fix a query that SQL Server rejected.
AGENT_MAX_RETRIES=3
# TOP limit added to queries that don't have one (protects the UI and DB).
AGENT_MAX_ROWS=200
# SQL Server cancels a query that runs longer than this.
QUERY_TIMEOUT_SECONDS=30
# Text columns with at most this many distinct values get sample values
# shown to the LLM (e.g. Status -> Delivered, Cancelled, Failed).
SCHEMA_SAMPLE_MAX_DISTINCT=20

# ---------------------------------------------------------------------
# API (Phase 4)
# ---------------------------------------------------------------------
# Comma-separated list of front-end origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
